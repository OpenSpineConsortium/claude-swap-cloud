{
  "manifest_version": 3,
  "name": "Claude Swap Cloud",
  "version": "0.2.0",
  "description": "Moves your claude.ai Projects between your own Claude accounts: export from one, sign in as the other, import. Works with cswap.",
  "minimum_chrome_version": "135",
  "key": "",
  "homepage_url": "https://github.com/OpenSpineConsortium/claude-swap-cloud",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["nativeMessaging", "userScripts", "storage", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "Claude Swap Cloud", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
