{
  "manifest_version": 3,
  "name": "cswap project import",
  "version": "0.1.0",
  "description": "Imports a claude.ai Project that the cswap command line exported into the account you are signed in to, one request at a time.",
  "minimum_chrome_version": "135",
  "key": "",
  "homepage_url": "https://github.com/Gregory-Schwing-MD-PhD/claude-swap",
  "icons": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" },
  "permissions": ["nativeMessaging", "userScripts", "storage", "sidePanel", "alarms", "notifications"],
  "host_permissions": ["https://claude.ai/*"],
  "background": { "service_worker": "src/background.js", "type": "module" },
  "content_scripts": [
    { "matches": ["https://claude.ai/*"], "js": ["src/content.js"], "run_at": "document_idle" }
  ],
  "side_panel": { "default_path": "sidepanel.html" },
  "action": { "default_title": "cswap import", "default_icon": { "16": "icons/16.png", "32": "icons/32.png", "48": "icons/48.png", "128": "icons/128.png" } },
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'" }
}
